{
  "name": "@cockpit/gui",
  "version": "0.1.0",
  "private": true,
  "description": "Host-neutral, accessible Cockpit GUI components",
  "type": "commonjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jj-ervin/cockpit-gui.git"
  },
  "homepage": "https://github.com/jj-ervin/cockpit-gui#readme",
  "bugs": {
    "url": "https://github.com/jj-ervin/cockpit-gui/issues"
  },
  "keywords": [
    "cockpit",
    "gui",
    "workspace",
    "command-palette",
    "accessibility"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/commandPaletteUI.test.js tests/workspaceUI.test.js tests/workbenchUI.test.js",
    "test:browser": "node --test browser-tests/*.test.js",
    "test:package": "node --test tests/packageDistribution.test.js"
  },
  "main": "./src/commandPaletteUI.js",
  "exports": {
    ".": "./src/commandPaletteUI.js",
    "./command-palette": "./src/commandPaletteUI.js",
    "./workspace": "./src/workspaceUI.js",
    "./styles.css": "./src/cockpitGUI.css",
    "./workbench": "./src/workbenchUI.js"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/PACKAGE-CONTRACTS.md",
    "src/"
  ],
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.56.1"
  }
}
